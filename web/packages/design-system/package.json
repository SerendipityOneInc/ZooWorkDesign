{
  "name": "@zooclaw/zooworkdesign",
  "version": "3.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./zoowork-theme.css": "./zoowork-theme.css",
    "./brand.css": "./brand.css",
    "./assets/*": "./assets/*",
    "./marketing.css": "./marketing.css",
    "./tailwind.css": "./tailwind.css"
  },
  "files": [
    "dist",
    "tokens.css",
    "zoowork-theme.css",
    "brand.css",
    "marketing.css",
    "tailwind.css",
    "assets",
    "BRAND_GUIDELINES.md",
