    "CHANGELOG.md",
    "SOURCE_MAP.md",
    "LICENSE",
    "NOTICE",
    "LICENSING.md",
    "THIRD_PARTY_NOTICES.md",
    "third-party",
    "LICENSE-CC-BY-4.0",
    "DESIGN_ASSETS.md",
    "ASSET_MANIFEST.json"
  ],
  "scripts": {
    "lint": "eslint src/ --max-warnings=0",
