    "build": "node ../../../scripts/build-package.mjs .",
    "prepack": "node ../../../scripts/sync-third-party.mjs --check"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.4.2",
    "radix-ui": "^1.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.0.0",
    "vaul": "^1.1.2",
    "motion": "^12.40.0",
    "usehooks-ts": "3.1.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "jsdom": "^26.1.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.7.4",
    "typescript-eslint": "^8.60.0",
    "vitest": "4.1.12"
