    "react-dom": "^19.2.7",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.4",
    "typescript-eslint": "^8.61.0",
    "vitest": "4.1.12",
